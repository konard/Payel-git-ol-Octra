      "html": "<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"0\">\n<style data-kid=\"1\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  \n  body {\n    font-family: 'Inter', sans-serif;\n    background-color: var(--k-color-bg-page);\n    color: var(--k-color-text-primary);\n    margin: 0;\n    overflow: hidden;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .dot-grid {\n    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);\n    background-size: 24px 24px;\n  }\n\n  .card-border {\n    border: 1px solid rgba(255, 255, 255, 0.08);\n  }\n\n  .metric-divider {\n    border-top: 1px solid rgba(255, 255, 255, 0.05);\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar { width: 5px; height: 5px; }\n  ::-webkit-scrollbar-track { background: transparent; }\n  ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }\n  ::-webkit-scrollbar-thumb:hover { background: var(--k-color-primary); }\n\n  .status-pulse {\n    position: relative;\n  }\n  .status-pulse::after {\n    content: '';\n    position: absolute;\n    inset: -2px;\n    border-radius: 9999px;\n    background: currentColor;\n    opacity: 0.4;\n    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n  }\n  @keyframes pulse {\n    0%, 100% { transform: scale(1); opacity: 0.4; }\n    50% { transform: scale(2); opacity: 0; }\n  }\n</style>\n\n<div class=\"flex h-screen overflow-hidden\" data-kid=\"2\">\n  \n  <aside class=\"w-16 flex-none bg-(--k-color-bg-surface) border-r border-(--k-color-border) flex flex-col items-center py-6 gap-8\" data-kid=\"3\">\n    <div class=\"w-9 h-9 bg-white rounded-lg flex items-center justify-center text-black shadow-lg\" data-kid=\"4\">\n      <i class=\"ti ti-hexagon-filled text-xl\" data-kid=\"5\"></i>\n    </div>\n    \n    <nav class=\"flex flex-col gap-7 text-(--k-color-text-mute