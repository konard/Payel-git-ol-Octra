bold text-white\" data-kid=\"178\">10%</span>\n              <span class=\"text-(--k-color-text-muted)\" data-kid=\"179\">Avg Latency</span> <span class=\"text-right font-bold text-white\" data-kid=\"180\">850ms</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"col-span-5 bg-(--k-color-bg-surface) rounded-2xl card-border p-8 flex flex-col shadow-sm\" data-kid=\"181\">\n        <div class=\"flex justify-between items-center mb-8\" data-kid=\"182\">\n          <div class=\"flex items-center gap-3 text-sm font-bold\" data-kid=\"183\">\n            <div class=\"w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center border border-indigo-500/20\" data-kid=\"184\">\n              <i class=\"ti ti-binary-tree text-indigo-400\" data-kid=\"185\"></i>\n            </div>\n            Active Pipeline Architecture\n          </div>\n          <button class=\"text-[11px] font-bold text-(--k-color-text-muted) border border-(--k-color-border) px-4 py-1.5 rounded-xl flex items-center gap-2 hover:bg-white/5 transition-all cursor-pointer\" data-kid=\"186\">\n            <i class=\"ti ti-edit text-xs\" data-kid=\"187\"></i> Edit Pipeline\n          </button>\n        </div>\n\n        <div class=\"space-y-8 overflow-y-auto pr-2 custom-scrollbar\" data-kid=\"188\">\n          \n          \n          <div data-kid=\"189\">\n            <div class=\"text-[10px] font-bold text-(--k-color-text-muted) uppercase tracking-[0.2em] mb-4 flex items-center gap-2\" data-kid=\"190\">\n              <span class=\"w-1.5 h-1.5 rounded-full bg-white/20\" data-kid=\"191\"></span>\n              1. INGRESS (ENTRY POINT)\n            </div>\n            <div class=\"space-y-3.5 bg-black/30 p-5 rounded-2xl border border-white/5 shadow-inner\" data-kid=\"192\">\n              <div class=\"flex justify-between items-center text-[11px]\" data-kid=\"193\">\n                <span class=\"text-(--k-color-text-muted) font-medium\" data-kid=\"194\">API Endpoint:</span>\n                <div class=\"flex items-center gap-3\" data-kid=\"195\">\n                  <span class=\"text-[11px] font-mono text-white/80\" data-kid=\"196\">/v1/chat/completions</span>\n                  <span class=\"px-2 py-0.5 bg-white/10 rounded text-[9px] font-black border border-white/10 text-white tracking-widest\" data-kid=\"197\">POST</span>\n                </div>\n              </div>\n              <div class=\"flex justify-between items-center text-[11px]\" data-kid=\"198\">\n                <span class=\"text-(--k-color-text-muted) font-medium\" data-kid=\"199\">Auth Protocol:</span>\n                <span class=\"font-bold text-white\" data-kid=\"200\">Bearer Token (Strict RSA)</span>\n              </div>\n              <div class=\"flex justify-between items-center text-[11px]\" data-kid=\"201\">\n                <span class=\"text-(--k-color-text-muted) font-medium\" data-kid=\"202\">Rate Limit:</span>\n                <div class=\"flex items-center gap-2\" data-kid=\"203\">\n                  <span class=\"text-(--k-color-text-muted) opacity-60\" data-kid=\"204\">req/min per IP</span>\n                  <span class=\"font-black text-white text-xs\" data-kid=\"205\">100</span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          \n          <div data-kid=\"206\">\n            <div class=\"text-[10px] font-bold text-(--k-color-text-muted) uppercase tracking-[0.2em] mb-4 flex items-center gap-2\" data-kid=\"207\">\n              <span class=\"w-1.5 h-1.5 rounded-full bg-white/20\" data-kid=\"208\"></span>\n              2. PRE-PROCESSING (MIDDLEWARE)\n            </div>\n            <div class=\"grid grid-cols-3 gap-3\" data-kid=\"209\">\n              <div class=\"bg-black/30 p-4 rounded-2xl border border-white/5 space-y-3 hover:bg-black/40 transition-colors\" data-kid=\"210\">\n                <div class=\"flex items-center gap-2 text-[10px] font-bold mb-1\" data-kid=\"211\">\n                  <i class=\"ti ti-mask text-blue-400\" data-kid=\"212\"></i> PII Redact\n                </div>\n                <div class=\"flex justify-between text-[9px]\" data-kid=\"213\"><span class=\"text-(--k-color-text-muted)\" data-kid=\"214\">Mode</span> <span class=\"font-black text-white\" data-kid=\"215\">MASK</span></div>\n                <div class=\"flex justify-between text-[9px]\" data-kid=\"216\"><span class=\"text-(--k-color-text-muted)\" data-kid=\"217\">Engine</span> <span class=\"font-black text-white\" data-kid=\"218\">NER</span></div>\n              </div>\n              <div class=\"bg-black/30 p-4 rounded-2xl border border-white/5 space-y-3 hover:bg-black/40 transition-colors\" data-kid=\"219\">\n                <div class=\"flex items-center gap-2 text-[10px] font-bold mb-1\" data-kid=\"220\">\n                  <i class=\"ti ti-shield-lock text-green-400\" data-kid=\"221\"></i> Injection\n                </div>\n                <div class=\"flex justify-between text-[9px]\" data-kid=\"222\"><span class=\"text-(--k-color-text-muted)\" data-kid=\"223\">Logic</span> <span class=\"font-black text-green-500\" data-kid=\"224\">ON</span></div>\n                <div class=\"flex justify-between text-[9px]\" data-kid=\"225\"><span class=\"text-(--k-color-text-muted)\" data-kid=\"226\">Vector</span> <span class=\"font-black text-white\" data-kid=\"227\">STRICT</span></div>\n              </div>\n              <div class=\"bg-black/30 p-4 rounded-2xl border border-white/5 space-y-3 hover:bg-black/40 transition-colors\" data-kid=\"228\">\n                <div class=\"flex items-center gap-2 text-[10px] font-bold mb-1\" data-kid=\"229\">\n                  <i class=\"ti ti-biohazard text-red-400\" data-kid=\"230\"></i> Toxicity\n                </div>\n                <div class=\"flex justify-between text-[9px]\" data-kid=\"231\"><span class=\"text-(--k-color-text-muted)\" data-kid=\"232\">Limit</span> <span class=\"font-black text-white\" data-kid=\"233\">0.85</span></div>\n                <div class=\"flex justify-between text-[9px]\" data-kid=\"234\"><span class=\"text-(--k-color-text-muted)\" data-kid=\"235\">Action</span> <span class=\"font-black text-red-500\" data-kid=\"236\">DROP</span></div>\n              </div>\n            </div>\n          </div>\n\n          \n          <div data-kid=\"237\">\n            <div class=\"text-[10px] font-bold text-(--k-color-text-muted) uppercase tracking-[0.2em] mb-4 flex items-center gap-2\" data-kid=\"238\">\n              <span class=\"w-1.5 h-1.5 rounded-full bg-white/20\" data-kid=\"239\"></span>\n              3. DYNAMIC ROUTER (DECISION MATRIX)\n            </div>\n            <div class=\"bg-black/30 rounded-2xl border border-white/5 overflow-hidden\" data-kid=\"240\">\n              <div class=\"flex justify-between items-center p-4 border-b border-white/5 bg-white/[0.02]\" data-kid=\"241\">\n                <div class=\"flex items-center gap-4\" data-kid=\"242\">\n                  <span class=\"text-[11px] font-black text-white/90 uppercase tracking-tighter\" data-kid=\"243\">Rule 01</span>\n                  <span class=\"px-2.5 py-0.5 bg-red-500/10 text-red-500 text-[9px] font-black rounded-full flex items-center gap-1.5 border border-red-500/20\" data-kid=\"244\">\n                    <span class=\"w-1 h-1 bg-red-500 rounded-full shadow-[0_0_8px_rgba(239,68,68,0.5)]\" data-kid=\"245\"></span> HIGH PRIORITY\n                  </span>\n                </div>\n                <button class=\"ti ti-dots-vertical text-(--k-color-text-muted) text-xs hover:text-white cursor-pointer\" data-kid=\"246\"></button>\n              </div>\n              <div class=\"p-5 space-y-5\" data-kid=\"247\">\n                <div class=\"flex items-center gap-3 text-[11px] font-mono leading-relaxed\" data-kid=\"248\">\n                  <span class=\"text-(--k-color-primary) font-bold\" data-kid=\"249\">IF</span>\n                  <span class=\"text-white/60 bg-white/5 px-2 py-1 rounded border border-white/5\" data-kid=\"250\">[ Intent ]</span>\n                  <span class=\"text-white/40 font-bold\" data-kid=\"251\">==</span>\n                  <span class=\"text-white/80 bg-white/5 px-2 py-1 rounded border border-white/5 flex gap-1.5 items-center\" data-kid=\"252\">\n                    [ <span class=\"text-(--k-color-primary)\" data-kid=\"253\">Billing</span> , <span class=\"text-(--k-color-primary)\" data-kid=\"254\">Refund</span> ]\n                  </span>\n                </div>\n                <div class=\"grid grid-cols-2 gap-y-3 pt-4 border-t border-white/5 text-[11px]\" data-kid=\"255\">\n                  <span class=\"text-(--k-color-text-muted) font-medium\" data-kid=\"256\">Target Route:</span> <span class=\"text-right font-black text-white\" data-kid=\"257\">GPT-4o (Production)</span>\n                  <span class=\"text-(--k-color-text-muted) font-medium\" data-kid=\"258\">Temperature:</span> <span class=\"text-right font-black text-white\" data-kid=\"259\">0.2</span>\n                  <span class=\"text-(--k-color-text-muted) font-medium\" data-kid=\"260\">Max Tokens:</span> <span class=\"text-right font-black text-white\" data-kid=\"261\">1024</span>\n                </div>\n              </div>\n              \n              \n              <div class=\"flex justify-between items-center p-4 border-t border-white/5 bg-white/[0.01] hover:bg-white/[0.03] transition-colors cursor-pointer group\" data-kid=\"262\">\n                <div class=\"flex items-center gap-4\" data-kid=\"263\">\n                  <span class=\"text-[11px] font-black text-white/60 group-hover:text-white transition-colors uppercase tracking-tighter\" data-kid=\"264\">Rule 02</span>\n                  <span class=\"px-2.5 py-0.5 bg-orange-500/10 text-orange-400 text-[9px] font-black rounded-full flex items-center gap-1.5 border border-orange-500/20\" data-kid=\"265\">\n                    <span class=\"w-1 h-1 bg-orange-500 rounded-full\" data-kid=\"266\"></span> MEDIUM\n                  </span>\n                </div>\n                <i class=\"ti ti-chevron-down text-(--k-color-text-muted) text-xs\" data-kid=\"267\"></i>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"bg-(--k-color-bg-surface) rounded-2xl card-border overflow-hidden shadow-sm\" data-kid=\"268\">\n      <div class=\"flex justify-between items-center p-8 border-b border-(--k-color-border)\" data-kid=\"269\">\n        <div class=\"flex items-center gap-3 text-sm font-bold\" data-kid=\"270\">\n          <div class=\"w-8 h-8 rounded-lg bg-orange-500/10 flex items-center justify-center border border-orange-500/20\" data-kid=\"271\">\n            <i class=\"ti ti-shield-alert text-orange-400\" data-kid=\"272\"></i>\n          </div>\n          Recent Guardrail Exceptions\n        </div>\n        <div class=\"flex items-center gap-4\" data-kid=\"273\">\n          <div class=\"flex items-center gap-2 bg-(--k-color-bg-page) rounded-xl border border-(--k-color-border) px-4 py-2 text-xs\" data-kid=\"274\">\n            <i class=\"ti ti-search text-(--k-color-text-muted)\" data-kid=\"275\"></i>\n            <input type=\"text\" placeholder=\"Filter logs...\" class=\"bg-transparent border-none focus:outline-hidden text-xs w-48\" data-kid=\"276\">\n          </div>\n          <button class=\"text-xs font-bold text-(--k-color-text-muted) border border-(--k-color-border) px-5 py-2 rounded-xl flex items-center gap-2 hover:bg-white/5 transition-all cursor-pointer\" data-kid=\"277\">\n            <i class=\"ti ti-filter-edit text-sm\" data-kid=\"278\"></i> Advanced Filter\n          </button>\n        </div>\n      </div>\n      <div class=\"overflow-x-auto\" data-kid=\"279\">\n        <table class=\"w-full text-left text-[11px] border-collapse\" data-kid=\"280\">\n          <thead data-kid=\"281\">\n            <tr class=\"bg-black/20 text-(--k-color-text-muted) font-bold uppercase tracking-[0.15em] border-b border-white/5\" data-kid=\"282\">\n              <th class=\"px-8 py-5\" data-kid=\"283\">Time <i class=\"ti ti-caret-down-filled ml-2 opacity-30\" data-kid=\"284\"></i></th>\n              <th class=\"px-8 py-5\" data-kid=\"285\">Client_ID</th>\n              <th class=\"px-8 py-5\" data-kid=\"286\">Violation / Security Rule</th>\n              <th class=\"px-8 py-5\" data-kid=\"287\">Prompt Snippet (Masked)</th>\n              <th class=\"px-8 py-5 text-right\" data-kid=\"288\">Action Taken</th>\n            </tr>\n          </thead>\n          <tbody class=\"divide-y divide-white/[0.03]\" data-kid=\"289\">\n            <tr class=\"hover:bg-white/[0.02] transition-colors group\" data-kid=\"290\">\n              <td class=\"px-8 py-5 text-white/90\" data-kid=\"291\">10:42:15 AM</td>\n              <td class=\"px-8 py-5 text-(--k-color-text-muted) font-mono\" data-kid=\"292\">user_892x</td>\n              <td class=\"px-8 py-5 font-bold text-white/90\" data-kid=\"293\">PII_Detector_v2 <span class=\"text-white/40 font-normal ml-2\" data-kid=\"294\">(Credit Card Info)</span></td>\n              <td class=\"px-8 py-5 font-mono text-[10px] text-white/50 italic\" data-kid=\"295\">\"payment with **** **** 1121\"</td>\n              <td class=\"px-8 py-5 text-right\" data-kid=\"296\">\n                <span class=\"px-3 py-1 bg-red-500/10 text-red-500 text-[9px] font-black rounded-lg border border-red-500/20 uppercase tracking-widest shadow-[0_0_12px_rgba(239,68,68,0.1)]\" data-kid=\"297\">Blocked</span>\n              </td>\n            </tr>\n            <tr class=\"hover:bg-white/[0.02] transition-colors group\" data-kid=\"298\">\n              <td class=\"px-8 py-5 text-white/90\" data-kid=\"299\">10:15:08 AM</td>\n              <td class=\"px-8 py-5 text-(--k-color-text-muted) font-mono\" data-kid=\"300\">user_110a</td>\n              <td class=\"px-8 py-5 font-bold text-white/90\" data-kid=\"301\">Prompt Injection <span class=\"text-white/40 font-normal ml-2\" data-kid=\"302\">(Pattern Match)</span></td>\n              <td class=\"px-8 py-5 font-mono text-[10px] text-white/50 italic\" data-kid=\"303\">\"ignore previous instructions and...\"</td>\n              <td class=\"px-8 py-5 text-right\" data-kid=\"304\">\n                <span class=\"px-3 py-1 bg-orange-500/10 text-orange-400 text-[9px] font-black rounded-lg border border-orange-500/20 uppercase tracking-widest\" data-kid=\"305\">Fallback</span>\n              </td>\n            </tr>\n            <tr class=\"hover:bg-white/[0.02] transition-colors group\" data-kid=\"306\">\n              <td class=\"px-8 py-5 text-white/90\" data-kid=\"307\">09:30:44 AM</td>\n              <td class=\"px-8 py-5 text-(--k-color-text-muted) font-mono\" data-kid=\"308\">sys_router</td>\n              <td class=\"px-8 py-5 font-bold text-white/90\" data-kid=\"309\">Upstream Timeout <span class=\"text-white/40 font-normal ml-2\" data-kid=\"310\">(GPT-4o > 5000ms)</span></td>\n              <td class=\"px-8 py-5 font-mono text-[10px] text-white/50 italic\" data-kid=\"311\">\"Summarize the attached 50 page...\"</td>\n              <td class=\"px-8 py-5 text-right\" data-kid=\"312\">\n                <span class=\"px-3 py-1 bg-red-500/10 text-red-500 text-[9px] font-black rounded-lg border border-red-500/20 uppercase tracking-widest\" data-kid=\"313\">Blocked</span>\n              </td>\n            </tr>\n            <tr class=\"hover:bg-white/[0.02] transition-colors group\" data-kid=\"314\">\n              <td class=\"px-8 py-5 text-white/90\" data-kid=\"315\">09:12:02 AM</td>\n              <td class=\"px-8 py-5 text-(--k-color-text-muted) font-mono\" data-kid=\"316\">user_4480</td>\n              <td class=\"px-8 py-5 font-bold text-white/90\" data-kid=\"317\">Schema Violation <span class=\"text-white/40 font-normal ml-2\" data-kid=\"318\">(Invalid JSON)</span></td>\n              <td class=\"px-8 py-5 font-mono text-[10px] text-white/50 italic\" data-kid=\"319\">\"{ 'user_name': 'John Doe', \"</td>\n              <td class=\"px-8 py-5 text-right\" data-kid=\"320\">\n                <span class=\"px-3 py-1 bg-blue-500/10 text-blue-400 text-[9px] font-black rounded-lg border border-blue-500/20 uppercase tracking-widest\" data-kid=\"321\">Retried</span>\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </main>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\" data-kid=\"322\"></script>\n<script data-kid=\"323\">\n  const createSparkline = (id, color, data) => {\n    new Chart(document.getElementById(id), {\n      type: 'bar',\n      data: {\n        labels: data.map((_, i) => i),\n        datasets: [{\n          data: data,\n          backgroundColor: color,\n          borderRadius: 3,\n          barThickness: 5\n        }]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        plugins: { legend: { display: false }, tooltip: { enabled: false } },\n        scales: {\n          x: { display: false },\n          y: { display: false, min: 0 }\n        }\n      }\n    });\n  };\n\n  window.onload = () => {\n    createSparkline('chart1', '#3b82f6', [15, 25, 20, 35, 30, 45, 40, 50, 45, 55, 48]);\n    createSparkline('chart2', '#8b5cf6', [45, 40, 50, 35, 30, 40, 45, 25, 20, 30, 15]);\n    createSparkline('chart3', '#f97316', [25, 30, 35, 30, 40, 45, 35, 50, 55, 45, 60]);\n    createSparkline('chart4', '#ef4444', [15, 20, 17, 23, 25, 20, 30, 27, 35, 25, 40]);\n  };\n</script>",
